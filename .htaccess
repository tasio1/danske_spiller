# sjovtdansk.dk — deployed by scripts/build-dist.sh + scripts/deploy.sh. Edit here, not on the server.

RewriteEngine On

# One host only: https://sjovtdansk.dk (no http, no www).
# The X-Forwarded-Proto check prevents a redirect loop if SSL is terminated at a proxy.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://sjovtdansk.dk%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^www\.sjovtdansk\.dk$ [NC]
RewriteRule ^ https://sjovtdansk.dk%{REQUEST_URI} [R=301,L,NE]

# Old folder name with spaces -> en-og-et/
RewriteRule ^en\ og\ et/(.*)$ /en-og-et/$1 [R=301,L,NE]

# Custom 404
ErrorDocument 404 /404.html

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

# Browser caching: fonts, images and icons change rarely; code revalidates quickly.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
</IfModule>
